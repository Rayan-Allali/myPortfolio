---
import { GitFork, Briefcase, Cpu, FileText } from "@lucide/astro";
import { GITHUB_PROFILE } from "../../const/links";

const availableModels = ["Next.js", "TypeScript", "React.js", "Nest.js", "Express.js", "Node.js"];
const experienceYears = new Date().getFullYear() - 2022;
const RESUME_LINK =
	"https://drive.google.com/file/d/1PxG82QyCLN-Lvtbdi5tHoVOfpAavBvMq/view?usp=sharing";
---

<div class="space-y-6">
<div class="inline-flex items-center gap-2 px-3 py-1 rounded border border-red-500/30 bg-red-500/5 text-red-400 text-xs font-mono mb-4">
    <span class="relative flex h-2 w-2">
        <span class="relative inline-flex rounded-full h-2 w-2 bg-red-500 shadow-[0_0_6px_rgba(239,68,68,0.6)]"></span>
    </span>
    CODEX ASTARTES :: IMPERATOR V.0.1
</div>
<h1 class="text-5xl lg:text-7xl font-bold tracking-tight">
    <span class="text-text-primary">Hello, I'm </span>
    <span class="text-primary">Allali Rayan</span>
  </h1>

    {/* Subtitle */}
   <p class="text-xl text-text-secondary max-w-xl lg:mx-0 font-light">
    <span class="text-primary font-mono">&lt;Architect /&gt;</span>
    Full-stack engineer focused on scalable systems and backend architecture.
  </p>
    
  {/* experience */}
    <div class="bg-linear-to-r from-primary/10 to-transparent border border-primary/20 rounded-lg p-5">

    <div class="flex flex-wrap items-center gap-4 pb-4 border-b border-primary/20">

      <div class="flex items-center gap-2">
        <Briefcase class="w-5 h-5 text-primary" />
        <div class="text-2xl font-bold text-text-primary">
          {experienceYears}+ Years
        </div>
      </div>

      <div class="text-xs text-text-secondary font-mono">
        Full-stack • Software Engineer • Architecture
      </div>

    </div>

    <!-- TECH STACK -->
    <div class="pt-4">

      <div class="flex items-center gap-2 mb-3">
        <Cpu class="w-3 h-3 text-primary" />
        <span class="text-xs font-mono text-text-muted tracking-wider">
          LOADED_MODULES
        </span>
        <div class="flex-1 h-px bg-linear-to-r from-primary/30 to-transparent"></div>
      </div>

      <div class="flex flex-wrap gap-2">
        {availableModels.map((model) => (
          <span class="px-2 py-1 text-[11px] font-mono rounded bg-primary/5 text-primary/70 border border-primary/10">
            {model}
          </span>
        ))}
      </div>

    </div>
  </div>

 <div class="flex flex-wrap gap-3 pt-2">

    <!-- CV DOWNLOAD -->
    <a href={RESUME_LINK} target="_blank"
       class="inline-flex items-center gap-2 px-4 py-2 rounded border border-primary/30 bg-primary/5 text-primary hover:bg-primary/10 transition-colors text-sm font-mono">

      <FileText class="w-4 h-4" />
      View CV
    </a>

    <!-- GITHUB -->
    <a href={GITHUB_PROFILE} target="_blank"
       class="inline-flex items-center gap-2 px-4 py-2 rounded border border-primary/20 text-text-secondary hover:text-primary hover:border-primary/40 transition-colors text-sm font-mono">

      <GitFork class="w-4 h-4" />
      GitHub
    </a>

  </div>
</div>
