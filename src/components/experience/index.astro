---
import SectionTitle from "../shared/section-title.astro";
import Section from "../shared/section.astro";
import { GitBranch, Calendar, FileCode } from "@lucide/astro";
import confirmooLogo from "/public/confirmoopdficon.png";
import sonalgazLogo from "/public/sonalgaz.png";
import atlasLogo from "/public/atlasmarketspace_logo.jpg";

export interface Experience {
	startedAt: Date;
	endedAt: Date | null;
	company: string;
	title: string;
	details: string;
	technologies: string[];
	commitHash: string;
	companyLogo?: string;
}

const experiences: Experience[] = [
	{
		companyLogo: confirmooLogo.src,
		startedAt: new Date("2024-06-01"),
		endedAt: new Date("2026-06-11"),
		company: "Confirmoo",
		title: "Fullstack Developer",
		details:
			"Developed and managed the admin dashboard, Super Admin portal, and backend APIs for e-commerce management system that facilitated automation of orders through various sales channels with different delivery companies. Also performed QA responsibilities including creating Jira tickets, reporting bugs, and testing new features.",
		technologies: [
			"React",
			"Next.js",
			"TypeScript",
			"Express.js",
			"GCP",
			"MongoDB",
			"Redis",
			"Jest",
			"TanStack Query",
			"Docker",
			"Jira",
		],
		commitHash: "3f7a9e2",
	},
	{
		startedAt: new Date("2024-02-01"),
		endedAt: new Date("2024-06-01"),
		company: "Freelance",
		title: "Freelance",
		details: "Developed and maintained web applications.",
		technologies: ["React", "Next.js", "Node.js", "Express.js", "Nest.js", "TypeScript"],
		commitHash: "533d164",
	},
	{
		startedAt: new Date("2023-12-01"),
		endedAt: new Date("2024-06-01"),
		company: "Google Developer Groups Algiers",
		title: "Developer Community Manager",
		details:
			"Led and coordinated development activities within GDG club, organized workshops, contributed to project direction and team coordination for internal initiatives.",
		technologies: [
			"React",
			"Nest.js",
			"TypeScript",
			"Web Development",
			"Jest",
			"Express.js",
			"Next.js",
			"JavaScript",
		],
		commitHash: "gdg2023a",
	},
	{
		companyLogo: atlasLogo.src,
		startedAt: new Date("2023-07-01"),
		endedAt: new Date("2024-02-12"),
		company: "Atlas Marketspace",
		title: "Frontend → Fullstack Developer",
		details:
			"Started with API integration, gradually took ownership of frontend features, and eventually expanded to full-stack development. Worked across the entire codebase using React, Next.js, Express.js, Firebase, and MongoDB.",
		technologies: [
			"JavaScript",
			"React",
			"Next.js",
			"Node.js",
			"Express.js",
			"Firebase",
			"TypeScript",
		],
		commitHash: "b4c8d1f",
	},
	{
		companyLogo: sonalgazLogo.src,
		startedAt: new Date("2023-03-01"),
		endedAt: new Date("2023-06-07"),
		company: "OSE Sonalgaz",
		title: "Software Engineering Intern",
		details:
			"Developed an industrial operations management platform using ASP.NET Core. Automated the generation of production, consumption, and operational reports from daily worksheets",
		technologies: [
			"JavaScript",
			"PostgreSQL",
			"C#",
			"ASP.NET Core 6",
			"Next.js",
			"React",
			"TypeScript",
		],
		commitHash: "d2f8c41",
	},
];

const formatDate = (date: Date): string => {
	return date.toLocaleDateString("en-US", { year: "numeric", month: "short" });
};

const getDateRange = (exp: Experience): string => {
	const start = formatDate(exp.startedAt);
	const end = exp.endedAt ? formatDate(exp.endedAt) : "Present";
	return `${start} - ${end}`;
};
---

<Section id="experience" class="flex-col gap-2">
    <SectionTitle title="git log --stat --oneline" icon={GitBranch} />
    

  {/* Timeline Container */}
  <div class="relative pl-8 lg:pl-0">
    <div class="absolute left-8 lg:left-1/2 top-0 bottom-0 w-px bg-primary/30 transform -translate-x-1/2 hidden lg:block"></div>
    <div class="absolute left-8 top-0 bottom-0 w-px bg-primary/30 lg:hidden"></div>

    <div class="space-y-16">
      {experiences.map((exp, index) => (
        <div class={`relative flex flex-col items-center gap-10 ${index % 2 === 0 ? 'lg:flex-row-reverse': 'lg:flex-row'}`}>
          {/* Date Box - Desktop (visible on larger screens) */}
          <div class={`hidden lg:flex ${ index % 2 !== 0 ?'lg:justify-end' : 'lg:justify-start'} w-1/2`}>
            <div class="flex items-center gap-2 bg-surface/50 px-4 py-2 rounded-full border border-primary/30 ">
              <Calendar class="w-3.5 h-3.5 text-primary" />
              <span class="font-mono text-xs text-text-secondary">{getDateRange(exp)}</span>
            </div>
          </div>

          {/* Timeline Dot */}
          <div class="absolute left-8 lg:left-1/2 transform -translate-x-1/2 flex items-center justify-center z-10">
            <div class="w-4 h-4 rounded-full bg-surface border-2 border-primary relative ring-4 ring-surface">
              <div class="absolute inset-0 bg-primary rounded-full opacity-20"></div>
            </div>
          </div>

          {/* Content Card */}
          <div class={`w-full lg:w-1/2 pl-12 ${index % 2 === 0 ? 'lg:pl-0': ''}`}>
            <div class="relative group lg:mr-10 lg:even:ml-10 lg:even:mr-0">
              {/* Horizontal Connector Line - Desktop */}
              <div class={`hidden lg:block absolute top-6 w-10 h-px bg-primary/30 -right-10 ${index % 2 !== 0 ? 'lg:-left-10': ''}`}></div>
              
              <div class="bg-surface rounded-lg border border-primary/20 overflow-hidden hover:border-primary/50 transition-all duration-300 shadow-xl group-hover:shadow-2xl hover:-translate-y-1">
                {/* Card Header */}
                <div class="bg-surface-2 px-4 py-2 border-b border-primary/20 flex items-center justify-between">
                  <div class="flex items-center gap-3">
                    <span class="font-mono text-xs text-accent">{exp.commitHash}</span>
                    <span class="hidden sm:inline-block px-1.5 py-0.5 rounded bg-primary/10 text-primary text-[10px] font-mono border border-primary/30">
                      HEAD ~ developer
                    </span>
                  </div>
                  <div class="flex items-center gap-2">
  {exp.companyLogo && <img src={exp.companyLogo} class="w-4 h-4 opacity-60" />}
  <span class="font-mono text-[10px] text-text-muted">{exp.company}</span>
</div>
                 
                </div>

                {/* Card Body */}
                <div class="p-6">
                  {/* Date - Mobile only */}
                  <div class="lg:hidden mb-4 flex items-center gap-2 text-xs text-text-muted font-mono">
                    <Calendar class="w-3 h-3" />
                    {getDateRange(exp)}
                  </div>

                  <h3 class="text-lg font-bold text-text-primary mb-1 group-hover:text-primary transition-colors">
                    {exp.title} <span class="text-text-muted font-normal text-sm">@{exp.company}</span>
                  </h3>

                  <div class="mt-4 space-y-2 font-mono text-sm text-text-secondary">
                    <p class="leading-relaxed border-l-2 border-primary/30 pl-4 py-1">
                      {exp.details}
                    </p>
                  </div>

                  {/* Technologies */}
                  <div class="mt-6 flex flex-wrap gap-2">
                    {exp.technologies.map(tech => (
                      <span class="px-2 py-1 text-[10px] font-mono rounded bg-primary/5 text-primary/80 border border-primary/20">
                        {tech}
                      </span>
                    ))}
                  </div>
                </div>

                {/* Card Footer */}
                <div class="bg-surface/50 px-4 py-2 border-t border-primary/20 flex items-center gap-4 text-[10px] font-mono text-text-muted">
                  <div class="flex items-center gap-1">
                    <FileCode class="w-3 h-3" />
                    <span>{exp.technologies.length} files changed</span>
                  </div>
                  <div class="flex items-center gap-1 text-green-500/80">
                    <span>+{exp.details.length * 2} insertions</span>
                  </div>
                  <div class="flex items-center gap-1 text-red-500/80">
                    <span>-{exp.details.length} deletions</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
    <div class="mt-16 text-center relative z-10">
      <div class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-surface border border-primary/30 text-xs font-mono text-text-secondary hover:text-primary transition-colors hover:border-primary/50 cursor-pointer">
        <span class="w-4 h-4 rounded-full bg-primary/30"></span>
        <span>Initial Commit (Start of Journey)</span>
      </div>
    </div>
  </div>

</Section>