---
import { GraduationCap, Calendar, MapPin, Award, FileText, ExternalLink } from "@lucide/astro";
import SectionTitle from "../shared/section-title.astro";
import Section from "../shared/section.astro";
interface Education {
	degree: string;
	field: string;
	institution: string;
	location: string;
	startDate: Date;
	endDate: Date | null;
	description?: string;
	achievements?: Array<{ text: string; link?: string }>; // Changed to support links
}

const educations: Education[] = [
	{
		degree: "Master's Degree",
		field: "Bioinformatics",
		institution: "USTHB (University of Science and Technology Houari Boumediene)",
		location: "Algiers, Algeria",
		startDate: new Date("2023-09-01"),
		endDate: new Date("2025-07-01"),
		description:
			"Focused on Machine Learning, Deep Learning, and Data Science. Studied data mining techniques, AI algorithms.",
		achievements: [
			{ text: "Thesis: Drug-Drug Interaction Extraction" },
			{
				text: "Research Paper",
				link: "https://drive.google.com/file/d/1tB1BGKfIDLL5VtEz7EaiSfx3cMFnWelI/view?usp=sharing",
			},
		],
	},
	{
		degree: "Bachelor's Degree",
		field: "Software and Information Systems Engineering",
		institution: "ISIL - USTHB",
		location: "Algiers, Algeria",
		startDate: new Date("2020-09-01"),
		endDate: new Date("2023-06-01"),
		description:
			"Software engineering foundation with focus on information systems, algorithms, and software development methodologies",
		achievements: [
			{
				text: "Thesis: Design and Implementation of an Information System for Electricity Production and Demand of the Electricity System Operator",
			},
			{
				text: "Research Paper",
				link: "https://drive.google.com/file/d/1f39EkaNkKogucosIrb2ooUiY0-0o7quU/view?usp=sharing",
			},
		],
	},
];

const formatDate = (date: Date): string => {
	return date.toLocaleDateString("en-US", { year: "numeric", month: "short" });
};

const getDateRange = (edu: Education): string => {
	const start = formatDate(edu.startDate);
	const end = edu.endDate ? formatDate(edu.endDate) : "Present";
	return `${start} - ${end}`;
};
---

<Section id="education" class="flex-col">
  <SectionTitle title="cat education_history.md" icon={GraduationCap} />
  
  <div class="space-y-6 mt-8">
    {educations.map((edu, index) => (
      <div class="relative group">
        {/* Card */}
        <div class="bg-surface rounded-lg border border-primary/20 overflow-hidden hover:border-primary/50 transition-all duration-300 shadow-xl group-hover:shadow-2xl hover:-translate-y-1">
          
          {/* Header */}
          <div class="bg-surface-2 px-6 py-3 border-b border-primary/20 flex flex-wrap items-center justify-between gap-2">
            <div class="flex items-center gap-3">
              <GraduationCap class="w-4 h-4 text-primary" />
              <span class="font-mono text-xs text-accent">{edu.degree}</span>
              <span class="hidden sm:inline-block px-1.5 py-0.5 rounded bg-primary/10 text-primary text-[10px] font-mono border border-primary/30">
                {edu.endDate ? "completed" : "in-progress"}
              </span>
            </div>
            <div class="flex items-center gap-2 text-text-muted">
              <MapPin class="w-3 h-3" />
              <span class="font-mono text-[10px]">{edu.location}</span>
            </div>
          </div>
          
          {/* Body */}
          <div class="p-6">
            <div class="flex flex-wrap justify-between items-start gap-4 mb-4">
              <div>
                <h3 class="text-xl font-bold text-text-primary group-hover:text-primary transition-colors">
                  {edu.field}
                </h3>
                <p class="text-sm text-text-secondary font-mono mt-1">{edu.institution}</p>
              </div>
              
              <div class="flex items-center gap-2 bg-surface/50 px-3 py-1 rounded-full border border-primary/20">
                <Calendar class="w-3 h-3 text-primary" />
                <span class="font-mono text-xs text-text-secondary">{getDateRange(edu)}</span>
              </div>
            </div>
            
            {edu.description && (
              <p class="text-text-secondary text-sm leading-relaxed border-l-2 border-primary/30 pl-4 py-1 mt-2">
                {edu.description}
              </p>
            )}
            
            {edu.achievements && edu.achievements.length > 0 && (
              <div class="mt-4">
                <div class="flex items-center gap-2 mb-2">
                  <Award class="w-3 h-3 text-accent" />
                  <span class="text-xs font-mono text-text-muted">achievements:</span>
                </div>
                <ul class="space-y-1.5">
                  {edu.achievements.map((achievement, idx) => (
                    <li class="flex items-start gap-2 text-xs text-text-secondary">
                      <span class="text-primary">▹</span>
                      {achievement.link ? (
                        <a 
                          href={achievement.link} 
                          target="_blank" 
                          class="hover:text-primary transition-colors inline-flex items-center gap-1"
                        >
                          {achievement.text}
                          <ExternalLink class="w-2.5 h-2.5" />
                        </a>
                      ) : (
                        <span>{achievement.text}</span>
                      )}
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </div>
          
          {/* Footer */}
          <div class="bg-surface/50 px-6 py-2 border-t border-primary/20 flex items-center gap-4 text-[10px] font-mono text-text-muted">
            <div class="flex items-center gap-1">
              <span class="text-primary">$</span>
              <span>cat {edu.field.toLowerCase().replace(/\s+/g, '-')}.md</span>
            </div>
            {edu.achievements?.some(a => a.link) && (
              <div class="flex items-center gap-1 ml-auto">
                <FileText class="w-3 h-3" />
                <span>research available</span>
              </div>
            )}
          </div>
        </div>
      </div>
    ))}
  </div>
</Section>