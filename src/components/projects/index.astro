---
import {
	FolderOpen,
	Code,
	Brain,
	Package,
	Trophy,
	Database,
	GitBranch,
	ExternalLink,
	ChevronRight,
	Users,
	Building2,
} from "@lucide/astro";
import SectionTitle from "../shared/section-title.astro";
import Section from "../shared/section.astro";
import { GITHUB_PROFILE } from "../../const/links";

interface Project {
	name: string;
	description: string;
	technologies: string[];
	category: "fullstack" | "ai" | "opensource" | "contributor" | "all";
	demoLink?: string;
	githubLink?: string;
	isPrivate: boolean;
	contribution?: string;
	language?: string;
	gdgProject?: boolean;
	isPinned?: boolean;
}

const projects: Project[] = [
	{
		name: "Nest-Init CLI",
		description:
			"CLI tool that automates NestJS project setup and configuration. Helps quickly scaffold new projects with REST APIs, GraphQL services, or database integrations.",
		technologies: ["TypeScript", "NestJS", "Node.js", "CLI", "npm"],
		category: "opensource",
		githubLink: "https://github.com/GDGAlgiers/nest-init-cli",
		isPrivate: false,
		contribution: "Contributor",
		language: "TypeScript",
		gdgProject: true,
		isPinned: true,
	},
	{
		name: "Web Navigation Package",
		description:
			"Navigation utility package for web applications, providing seamless routing and navigation utilities.",
		technologies: ["TypeScript", "React", "Next.js", "npm"],
		category: "opensource",
		githubLink: "https://github.com/GDGAlgiers/web-navigation-package",
		isPrivate: false,
		contribution: "Contributor",
		language: "TypeScript",
		gdgProject: true,
		isPinned: true,
	},
	{
		name: "GCPC Challenges 2024",
		description:
			"Competitive programming challenges for GCPC 2024. Contributed problem statements and test cases.",
		technologies: ["Problem Solving", "Algorithms", "C++", "Python"],
		category: "contributor",
		githubLink: "https://github.com/GDGAlgiers/GCPC-Challenges",
		isPrivate: false,
		contribution: "Challenge author",
		gdgProject: true,
	},
	{
		name: "GLP Platform",
		description:
			"GLP (GDG Learning Platform) is a community driven initiative designed to make tech education accessible to everyone.",
		technologies: ["NestJS", "TypeScript", "PostgreSQL", "TypeORM", "JWT"],
		category: "fullstack",
		demoLink: "https://glp.gdgalgiers.dev",
		isPrivate: false,
		contribution: "Contributor",
		language: "TypeScript",
		gdgProject: true,
		isPinned: true,
	},
	{
		name: "DDI Extraction",
		description:
			"Drug drug interaction extraction system using BioBERT and GAT Network . Academic project",
		technologies: ["Python", "FastAPI", "BioBERT", "Transformers", "Machine Learning", "NLP"],
		category: "ai",
		isPrivate: true,
		gdgProject: false,
		language: "Python",
		isPinned: false,
	},
];

const gdgProjects = projects.filter((p) => p.gdgProject === true);
const pinnedProjects = projects.filter((p) => p.isPinned).slice(0, 4);
---

<Section id="projects" class="flex-col">
  <SectionTitle title="ls -la ~/projects" icon={FolderOpen} />

  {/* GDG CONTRIBUTIONS BANNER */}
  <div class="mt-6 mb-8 p-4 bg-linear-to-r from-primary/10 via-transparent to-transparent border-l-4 border-primary rounded-r-lg">
    <div class="flex items-center gap-3">
      <Building2 class="w-5 h-5 text-primary" />
      <div>
        <div class="font-mono text-sm font-bold text-text-primary">GDG Algiers Contributions</div>
        <p class="text-xs text-text-secondary mt-0.5">These projects were developed as part of the Google Developer Group Algiers community</p>
      </div>
    </div>
    <div class="flex flex-wrap gap-2 mt-3 ml-8">
      {gdgProjects.map(p => (
        <a href={p.githubLink || p.demoLink} target="_blank" class="text-[10px] px-2 py-1 rounded-full bg-primary/10 text-primary/90 border border-primary/30 hover:bg-primary/20 transition-colors">
          {p.name}
        </a>
      ))}
    </div>
  </div>

  <div class="flex flex-col lg:flex-row gap-8 items-start mt-4">
    
    {/* LEFT SIDEBAR - Repositories List */}
    <div class="w-full lg:w-1/3">
      <div class="bg-surface rounded-lg border border-primary/20 overflow-hidden sticky top-24">
        <div class="bg-syrface-2 px-4 py-3 border-b border-primary/20 flex items-center justify-between">
          <div class="flex items-center gap-2">
            <Database class="w-4 h-4 text-primary" />
            <span class="text-sm font-mono text-text-primary">Repositories</span>
          </div>
          <span class="text-xs font-mono text-text-muted bg-primary/10 px-2 py-0.5 rounded-full">{projects.length}</span>
        </div>
        
        <div class="divide-y divide-primary/20 max-h-125 overflow-y-auto custom-scrollbar" id="repo-list">
          {projects.map((repo, idx) => (
            <div 
              class="repo-item block p-4 hover:bg-primary/5 transition-colors group cursor-pointer"
              data-category={repo.category}
            >
              <a href={repo.githubLink || repo.demoLink || "#"} target="_blank" class="block">
                <div class="flex items-center justify-between mb-1.5">
                  <div class="flex items-center gap-2">
                    <span class="font-mono text-sm text-primary group-hover:underline truncate max-w-37.5">
                      {repo.name}
                    </span>
                    {repo.gdgProject && (
                      <span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded-full bg-primary/20 text-primary text-[9px] font-mono border border-primary/40">
                        <Users class="w-2.5 h-2.5" />
                        GDG
                      </span>
                    )}
                  </div>
                  <span class="text-[9px] px-2 py-0.5 rounded-full border border-primary/30 text-text-muted">
                    {repo.isPrivate ? "Private" : "Public"}
                  </span>
                </div>
                <p class="text-xs text-text-secondary line-clamp-2 mb-2">
                  {repo.description?.slice(0, 80)}...
                </p>
                <div class="flex items-center gap-4 text-[10px] text-text-muted">
                  {repo.language && (
                    <div class="flex items-center gap-1">
                      <span class="w-2 h-2 rounded-full bg-primary"></span>
                      <span>{repo.language}</span>
                    </div>
                  )}
                  {repo.contribution && (
                    <span class="text-accent/70">{repo.contribution}</span>
                  )}
                </div>
              </a>
            </div>
          ))}
        </div>
      </div>
    </div>

    {/* RIGHT SIDE - Pinned Projects Grid */}
    <div class="w-full lg:w-2/3">
      <div class="flex items-center gap-2 mb-4">
        <span class="text-xs font-mono text-text-muted tracking-wider">PINNED PROJECTS</span>
        <div class="flex-1 h-px bg-linear-to-r from-primary/30 to-transparent"></div>
      </div>
      
      <div class="grid md:grid-cols-2 gap-5" id="projects-grid">
        {pinnedProjects.map((project, idx) => (
          <div 
            class="project-card bg-surface rounded-lg border border-primary/20 p-5 hover:border-primary/50 transition-all hover:-translate-y-1 group"
            data-category={project.category}
          >
            <div class="flex items-start justify-between mb-3">
              <div class="flex items-center gap-2 flex-wrap">
                {project.category === "fullstack" && <Code class="w-4 h-4 text-primary" />}
                {project.category === "ai" && <Brain class="w-4 h-4 text-accent" />}
                {project.category === "opensource" && <Package class="w-4 h-4 text-primary" />}
                <a href={project.githubLink || project.demoLink} target="_blank" class="font-mono text-sm text-primary group-hover:underline">
                  {project.name}
                </a>
                {project.gdgProject && (
                  <span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded-full bg-primary/20 text-primary text-[9px] font-mono border border-primary/40">
                    <Users class="w-2.5 h-2.5" />
                    GDG
                  </span>
                )}
              </div>
              <span class="text-[9px] px-2 py-0.5 rounded-full border border-primary/30 text-text-muted shrink-0">
                {project.isPrivate ? "Private" : "Public"}
              </span>
            </div>
            
            <p class="text-xs text-text-secondary mb-4 line-clamp-3 leading-relaxed">
              {project.description}
            </p>
            
            <div class="flex flex-wrap gap-2 mb-4">
              {project.technologies.slice(0, 4).map(tech => (
                <span class="text-[9px] px-2 py-0.5 rounded-full bg-primary/5 text-primary/80 border border-primary/20">
                  {tech}
                </span>
              ))}
            </div>
            
            <div class="flex items-center justify-between pt-3 border-t border-primary/20">
              <div class="flex items-center gap-2">
                {project.contribution && (
                  <span class="text-[9px] text-accent/70 font-mono">{project.contribution}</span>
                )}
              </div>
              <div class="flex items-center gap-3">
                {project.githubLink && (
                  <a href={project.githubLink} target="_blank" class="text-xs font-mono text-text-muted hover:text-primary transition-colors">
                    repo →
                  </a>
                )}
                {project.demoLink && !project.githubLink && (
                  <a href={project.demoLink} target="_blank" class="text-xs font-mono text-text-muted hover:text-primary transition-colors">
                    demo →
                  </a>
                )}
              </div>
            </div>
          </div>
        ))}
      </div>
      
      <div class="mt-8 text-center">
        <a href={GITHUB_PROFILE} target="_blank" class="inline-flex items-center gap-2 text-sm font-mono text-text-secondary hover:text-primary transition-colors group">
          <span>View all repositories</span>
          <ChevronRight class="w-4 h-4 group-hover:translate-x-1 transition-transform" />
        </a>
      </div>
    </div>
    
  </div>
</Section>

<style is:global>
  .custom-scrollbar::-webkit-scrollbar {
    width: 4px;
  }
  .custom-scrollbar::-webkit-scrollbar-track {
    background: rgba(77, 163, 255, 0.1);
    border-radius: 4px;
  }
  .custom-scrollbar::-webkit-scrollbar-thumb {
    background: rgba(77, 163, 255, 0.4);
    border-radius: 4px;
  }
  .custom-scrollbar::-webkit-scrollbar-thumb:hover {
    background: rgba(77, 163, 255, 0.6);
  }
</style>