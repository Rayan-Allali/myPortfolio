---
import {
  Cpu,
  CodeXml,
  GitMerge,
  Radio,
  GraduationCap,
  Folder,
  type AstroComponent
} from "@lucide/astro";

import SidebarDesktop from "./sideBarDesktop.astro";
import SideBarMobile from "./sidebarMobile.astro";

export interface NavItem {
  title: string;
  link: string;
  icon: AstroComponent;
}

export const navItems: NavItem[] = [
  { title: "About", link: "#", icon: Cpu },
  { title: "Skills", link: "#skills", icon: CodeXml },
  { title: "Experience", link: "#experience", icon: GitMerge },
  { title: "Projects", link: "#projects", icon: Folder },
  { title: "Education", link: "#education", icon: GraduationCap },
  { title: "Contact", link: "#contact", icon: Radio }
];
---

<>
  <SidebarDesktop navItems={navItems} />
  <SideBarMobile navItems={navItems} />

  <script is:inline>
   function initSidebar() {
    const navLinks = document.querySelectorAll("[data-nav-link]");
    const sections = document.querySelectorAll("section[id]");

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;

          navLinks.forEach((link) => {
            const section = link.dataset.section;

            const isAbout =
              section === "" && entry.target.id === "";

            const isMatch =
              section === entry.target.id;

            link.classList.toggle(
              "active",
              isAbout || isMatch
            );
          });
        });
      },
      {
        threshold: 0.3,
      }
    );

    sections.forEach((section) => observer.observe(section));
  }

  window.addEventListener("load", initSidebar);
  document.addEventListener("astro:page-load", initSidebar);
  </script>
</>