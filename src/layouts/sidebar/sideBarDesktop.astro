---
import type { NavItem } from "./sidebar.astro";

interface Props {
	navItems: Array<NavItem>;
}

const { navItems } = Astro.props;
---

<div class="hidden lg:flex fixed right-8 top-1/2 -translate-y-1/2 flex-col items-center z-50">

  <div class="absolute top-0 bottom-0 w-px bg-linear-to-b from-transparent via-primary/40 to-transparent -z-10"></div>

  <div class="flex flex-col gap-4 items-center">
    {navItems.map((item) => {
      const Icon = item.icon;

      return (
        <a
          href={item.link}
          data-nav-link
          data-section={item.link.replace("#", "")}
          class="nav-link relative group flex items-center justify-center w-12 h-12 transition-all duration-300 outline-none"
          aria-label={item.title}
        >
          {/* Tooltip */}
          <div class="absolute right-14 px-3 py-1.5 rounded-md bg-surface border border-primary/30 text-xs font-mono whitespace-nowrap opacity-0 group-hover:opacity-100 transition-all duration-300 translate-x-2 group-hover:translate-x-0 pointer-events-none shadow-lg flex items-center gap-2 z-20">
            <span class="text-primary">{">"}</span>

            <span class="tooltip-text text-xs font-mono text-text-secondary transition-all">
              {item.title}
            </span>
          </div>

          <div class="relative w-full h-full flex items-center justify-center">

            <div
              class="desktop-ring absolute inset-0 m-auto rounded-full border border-primary/50 opacity-0 scale-0 transition-all duration-500 ease-out"
              style="border-style:dashed;"
            />

            <div
              class="desktop-dot rounded-full transition-all duration-300 ease-out flex items-center justify-center relative z-10 w-3 h-3 bg-surface border border-text-muted/30 group-hover:w-4 group-hover:h-4 group-hover:border-primary/50 group-hover:bg-primary/20"
            >
             <Icon
            class="desktop-icon opacity-0 scale-0 w-0 h-0 transition-all duration-300 group-[.active]:opacity-100 group-[.active]:scale-100 group-[.active]:w-4 group-[.active]:h-4"
          />
            </div>

          </div>
        </a>
      );
    })}
  </div>

  <div class="mt-6 w-px h-6 bg-primary/30"></div>

  <div class="mt-2 text-[8px] font-mono text-text-muted rotate-90 whitespace-nowrap tracking-wider">
    IMPERATOR
  </div>

</div>